<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Confirm Order</title>
  </head>
  <body>
    <h1>Thank you for your order, <%= order.fname %></h1>
    <h2>Order Summary</h2>
    <p>Order ID : <%= order.id%></p>
    <p>Name: <%= order.fname %> <%= order.lname %></p>
    <p>Email <%= order.ename%></p>
    <p>Pickup or Delivery: <%= order.method %></p>
    <p>Toppings: <%= order.toppings %></p>
    <p>Size: <%= order['pizza-size']%></p>
    <p>Comment: <%= order.comment %></p>
    <p>Size: <%= order.timestamp%></p>
  </body>
</html>
